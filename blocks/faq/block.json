{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "floe/faq",
	"version": "1.0.0",
	"title": "FAQ",
	"category": "floe-sections",
	"icon": "editor-help",
	"description": "A list of questions and answers, built with WordPress's own Details block. Put it in an Intro for a heading.",
	"keywords": [ "questions", "accordion", "help" ],
	"textdomain": "floe",
	"allowedBlocks": [ "core/details" ],
	"attributes": {
		"oneOpen": { "type": "boolean", "default": false },
		"schema": { "type": "boolean", "default": false }
	},
	"usesContext": [ "floe/nested" ],
	"supports": {
		"html": false,
		"anchor": true,
		"floeIntro": [ "beside", "above" ]
	},
	"example": { "innerBlocks": [ { "name": "core/details", "attributes": { "summary": "Can we edit the site ourselves?" }, "innerBlocks": [ { "name": "core/paragraph", "attributes": { "content": "Yes. Every section is edited in place." } } ] } ] },
	"editorScript": "file:./assets/faq-editor.js",
	"style": "file:./assets/faq.css",
	"render": "file:./faq.php"
}
