{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "floe/steps",
	"version": "1.0.0",
	"title": "Steps",
	"category": "floe-sections",
	"icon": "editor-ol",
	"description": "Three to five numbered, connected steps. Put it in an Intro for a heading.",
	"keywords": [ "process", "timeline", "how it works" ],
	"textdomain": "floe",
	"allowedBlocks": [ "floe/step" ],
	"attributes": {
		"surface": { "type": "string", "enum": [ "subtle", "base", "tint" ], "default": "subtle" }
	},
	"usesContext": [ "floe/nested" ],
	"supports": {
		"html": false,
		"anchor": true,
		"floeIntro": [ "above" ]
	},
	"example": { "innerBlocks": [ { "name": "floe/step", "attributes": { "title": "Discover", "text": "We agree goals and audiences." } }, { "name": "floe/step", "attributes": { "title": "Design", "text": "Brand tokens are applied." } }, { "name": "floe/step", "attributes": { "title": "Launch", "text": "The site goes live." } } ] },
	"editorScript": "file:./assets/steps-editor.js",
	"style": "file:./assets/steps.css",
	"render": "file:./steps.php"
}
