{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "floe/images",
	"version": "1.0.0",
	"title": "Images",
	"category": "floe-sections",
	"icon": "format-gallery",
	"description": "Rows of one, two or three images or looping MP4s. Put it in an Intro for a heading.",
	"keywords": [ "gallery", "grid", "photos" ],
	"textdomain": "floe",
	"allowedBlocks": [ "floe/image-row" ],
	"attributes": {
		"fit": { "type": "string", "enum": [ "fill", "natural" ], "default": "fill" }
	},
	"providesContext": {
		"floe/imagesFit": "fit"
	},
	"usesContext": [ "floe/nested" ],
	"supports": {
		"html": false,
		"anchor": true,
		"floeIntro": [ "above", "beside" ]
	},
	"example": { "innerBlocks": [ { "name": "floe/image-row", "innerBlocks": [ { "name": "floe/media" }, { "name": "floe/media" } ] } ] },
	"editorScript": "file:./assets/images-editor.js",
	"style": "file:./assets/images.css",
	"render": "file:./images.php"
}
