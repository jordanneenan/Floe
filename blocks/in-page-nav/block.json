{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "floe/in-page-nav",
	"version": "1.0.0",
	"title": "In-page navigation",
	"category": "floe-sections",
	"icon": "list-view",
	"description": "A sticky bar linking to the sections on a long page. Built automatically from section anchors, with a manual override.",
	"keywords": [ "anchors", "jump links", "table of contents", "sticky" ],
	"textdomain": "floe",
	"attributes": {
		"label": { "type": "string", "default": "" },
		"items": { "type": "array", "default": [], "items": { "type": "object" } },
		"action": { "type": "object", "default": {} }
	},
	"supports": {
		"html": false,
		"anchor": false,
		"floeSection": false
	},
	"example": { "attributes": { "label": "On this page", "items": [ { "label": "Overview", "anchor": "overview" }, { "label": "Process", "anchor": "process" } ] } },
	"editorScript": "file:./assets/in-page-nav-editor.js",
	"style": "file:./assets/in-page-nav.css",
	"viewScript": "file:./assets/in-page-nav.js",
	"render": "file:./in-page-nav.php"
}
