{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "floe/team",
	"version": "1.0.0",
	"title": "Team",
	"category": "floe-sections",
	"icon": "groups",
	"description": "A grid of people: portrait, name and role. Put it in an Intro for a heading.",
	"keywords": [ "people", "staff", "about" ],
	"textdomain": "floe",
	"allowedBlocks": [ "floe/person" ],
	"attributes": {
	},
	"usesContext": [ "floe/nested" ],
	"supports": {
		"html": false,
		"anchor": true,
		"floeIntro": [ "above" ]
	},
	"example": { "innerBlocks": [ { "name": "floe/person", "attributes": { "name": "Sam Carter", "role": "Lead designer" } }, { "name": "floe/person", "attributes": { "name": "Riley Nguyen", "role": "WordPress developer" } } ] },
	"editorScript": "file:./assets/team-editor.js",
	"style": "file:./assets/team.css",
	"render": "file:./team.php"
}
