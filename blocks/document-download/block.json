{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "floe/document-download",
	"version": "1.0.0",
	"title": "Document Download",
	"category": "floe-sections",
	"icon": "download",
	"description": "A list of downloadable files. Type and size come from the media library. Put it in an Intro for a heading.",
	"keywords": [ "files", "pdf", "documents", "resources" ],
	"textdomain": "floe",
	"allowedBlocks": [ "floe/download" ],
	"usesContext": [ "floe/nested" ],
	"supports": {
		"html": false,
		"anchor": true,
		"floeIntro": [ "beside", "above" ]
	},
	"example": { "innerBlocks": [ { "name": "floe/download", "attributes": { "title": "Annual report" } } ] },
	"editorScript": "file:./assets/document-download-editor.js",
	"style": "file:./assets/document-download.css",
	"render": "file:./document-download.php"
}
