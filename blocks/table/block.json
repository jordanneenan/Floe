{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "floe/table",
	"version": "1.0.0",
	"title": "Table",
	"category": "floe-sections",
	"icon": "editor-table",
	"description": "A comparison table built with WordPress's own Table block, with an optional highlighted column. Put it in an Intro for a heading.",
	"keywords": [ "comparison", "pricing", "plans" ],
	"textdomain": "floe",
	"allowedBlocks": [ "core/table" ],
	"attributes": {
		"highlight": { "type": "number", "default": 0 },
		"badge": { "type": "string", "default": "" },
		"emphasiseLastRow": { "type": "boolean", "default": false }
	},
	"usesContext": [ "floe/nested" ],
	"supports": {
		"html": false,
		"anchor": true,
		"floeIntro": [ "above" ]
	},
	"example": { "attributes": { "highlight": 1, "badge": "Popular" } },
	"editorScript": "file:./assets/table-editor.js",
	"style": "file:./assets/table.css",
	"render": "file:./table.php"
}
