{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "floe/stats",
	"version": "1.0.0",
	"title": "Stats",
	"category": "floe-sections",
	"icon": "chart-bar",
	"description": "Two to four figures, each with an optional accent unit and a short label. Add a Block intro above it for a heading.",
	"keywords": [ "numbers", "figures", "metrics" ],
	"textdomain": "floe",
	"allowedBlocks": [ "floe/stat" ],
	"attributes": {
		"countUp": { "type": "boolean", "default": false }
	},
	"usesContext": [ "floe/nested" ],
	"supports": {
		"html": false,
		"anchor": true
	},
	"example": { "innerBlocks": [ { "name": "floe/stat", "attributes": { "value": "40", "unit": "+", "label": "Sites launched" } }, { "name": "floe/stat", "attributes": { "value": "6", "unit": "wks", "label": "Brief to launch" } } ] },
	"editorScript": "file:./assets/stats-editor.js",
	"style": "file:./assets/stats.css",
	"viewScript": "file:./assets/stats.js",
	"render": "file:./stats.php"
}
