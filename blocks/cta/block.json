{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "floe/cta",
	"version": "2.0.0",
	"title": "CTA",
	"category": "floe-sections",
	"icon": "megaphone",
	"description": "One to three call to action panels side by side. A single panel is a wide banner; two or three sit in columns.",
	"keywords": [ "call to action", "contact", "panel", "columns" ],
	"textdomain": "floe",
	"allowedBlocks": [ "floe/cta-panel" ],
	"attributes": {},
	"supports": {
		"html": false,
		"anchor": true
	},
	"example": {
		"innerBlocks": [
			{ "name": "floe/cta-panel", "attributes": { "eyebrow": "Ready when you are", "heading": "Make the next step clear", "body": "A short, focused invitation keeps the choice simple.", "action": { "label": "Start a project", "url": "#" } } }
		]
	},
	"editorScript": "file:./assets/cta-editor.js",
	"style": "file:./assets/cta.css",
	"render": "file:./cta.php"
}
