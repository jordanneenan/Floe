{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "floe/posts",
	"version": "2.0.0",
	"title": "Posts",
	"category": "floe-sections",
	"icon": "grid-view",
	"description": "A grid of post cards: the latest of any post type (a set number or all, with load more and filters), hand-picked posts, or manual entries. Add a Block intro above it for a heading.",
	"keywords": [
		"news",
		"blog",
		"journal",
		"articles",
		"listing",
		"load more",
		"filter"
	],
	"textdomain": "floe",
	"allowedBlocks": [
		"floe/post-item"
	],
	"attributes": {
		"source": {
			"type": "string",
			"enum": [
				"latest",
				"picker",
				"manual"
			],
			"default": "latest"
		},
		"postType": {
			"type": "string",
			"default": "post"
		},
		"count": {
			"type": "number",
			"default": 3
		},
		"showAll": {
			"type": "boolean",
			"default": false
		},
		"more": {
			"type": "string",
			"enum": [
				"none",
				"button",
				"scroll"
			],
			"default": "none"
		},
		"taxonomy": {
			"type": "string",
			"default": ""
		},
		"term": {
			"type": "number",
			"default": 0
		},
		"showFilters": {
			"type": "boolean",
			"default": false
		},
		"posts": {
			"type": "array",
			"default": [],
			"items": {
				"type": "number"
			}
		},
		"mediaOverrides": {
			"type": "object",
			"default": {}
		}
	},
	"usesContext": [
		"floe/nested",
		"floe/headingLevel"
	],
	"supports": {
		"html": false,
		"anchor": true
	},
	"example": {},
	"editorScript": "file:./assets/posts-editor.js",
	"style": "file:./assets/posts.css",
	"viewScript": "file:./assets/posts.js",
	"render": "file:./posts.php"
}
