{
  "name": "floe-wordpress-theme",
  "version": "0.1.0",
  "private": true,
  "description": "Modular WordPress theme: native WordPress first, one folder per block and component.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:css": "node scripts/build.mjs --css",
    "build:js": "node scripts/build.mjs --js",
    "start": "node scripts/build.mjs --watch",
    "lint:js": "wp-scripts lint-js \"Blocks/**/*.js\" \"Components/**/*.js\" \"Assets/js/**/*.js\" --ignore-pattern \"**/assets/**\" --ignore-pattern \"Assets/js/build/**\"",
    "lint:css": "wp-scripts lint-style \"Blocks/**/*.scss\" \"Components/**/*.scss\" \"Assets/scss/**/*.scss\"",
    "lint": "npm run lint:js && npm run lint:css"
  },
  "devDependencies": {
    "@wordpress/babel-preset-default": "^8.56.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^6.56.0",
    "@wordpress/scripts": "^35.0.0",
    "babel-loader": "^10.1.1",
    "browser-sync": "^3.0.4",
    "chokidar": "^5.0.0",
    "geist": "^1.7.2",
    "sass": "^1.105.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^5.1.4"
  }
}
