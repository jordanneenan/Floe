{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "floe/images",
  "version": "0.1.0",
  "title": "Images",
  "category": "design",
  "icon": "images-alt",
  "description": "Repeatable one-, two-, and three-column image or silent MP4 rows.",
  "textdomain": "floe",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "html": false
  },
  "editorScript": "file:./Assets/images.js",
  "style": "file:./Assets/images.css",
  "render": "file:./render.php"
}
