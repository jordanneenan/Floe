{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "floe/cards",
  "version": "0.1.0",
  "title": "Cards",
  "category": "design",
  "icon": "screenoptions",
  "description": "Manually entered cards in a fixed section layout.",
  "textdomain": "floe",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "html": false
  },
  "editorScript": "file:./Assets/cards.js",
  "style": "file:./Assets/cards.css",
  "render": "file:./render.php"
}
