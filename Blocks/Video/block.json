{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "floe/video",
  "version": "0.1.0",
  "title": "Video",
  "category": "design",
  "icon": "video-alt3",
  "description": "Floe Video section.",
  "textdomain": "floe",
  "attributes": {
    "heading": {
      "type": "string",
      "default": ""
    },
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "body": {
      "type": "string",
      "default": ""
    },
    "buttonLabel": {
      "type": "string",
      "default": ""
    },
    "buttonUrl": {
      "type": "string",
      "default": ""
    },
    "youtubeUrl": {
      "type": "string",
      "default": ""
    },
    "coverId": {
      "type": "number",
      "default": 0
    },
    "coverType": {
      "type": "string",
      "default": "image"
    },
    "coverUrl": {
      "type": "string",
      "default": ""
    },
    "coverAlt": {
      "type": "string",
      "default": ""
    },
    "coverPosterId": {
      "type": "number",
      "default": 0
    },
    "coverPosterUrl": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "html": false
  },
  "editorScript": "file:./Assets/video.js",
  "style": "file:./Assets/video.css",
  "render": "file:./render.php"
}
