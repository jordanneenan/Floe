{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "floe/image-copy",
  "version": "0.1.0",
  "title": "Image + Copy",
  "category": "design",
  "icon": "columns",
  "description": "Floe Image + Copy section.",
  "textdomain": "floe",
  "attributes": {
    "heading": {
      "type": "string",
      "default": ""
    },
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "body": {
      "type": "string",
      "default": ""
    },
    "buttonLabel": {
      "type": "string",
      "default": ""
    },
    "buttonUrl": {
      "type": "string",
      "default": ""
    },
    "mediaId": {
      "type": "number",
      "default": 0
    },
    "mediaType": {
      "type": "string",
      "default": "image"
    },
    "mediaUrl": {
      "type": "string",
      "default": ""
    },
    "mediaAlt": {
      "type": "string",
      "default": ""
    },
    "mediaPosterId": {
      "type": "number",
      "default": 0
    },
    "mediaPosterUrl": {
      "type": "string",
      "default": ""
    },
    "mediaRight": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "html": false
  },
  "editorScript": "file:./Assets/image-copy.js",
  "style": "file:./Assets/image-copy.css",
  "render": "file:./render.php"
}
