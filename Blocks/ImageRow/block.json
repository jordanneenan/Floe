{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "floe/image-row",
  "version": "0.1.0",
  "title": "Images row",
  "category": "media",
  "icon": "images-alt2",
  "description": "One-, two-, or three-column media row.",
  "textdomain": "floe",
  "parent": [
    "floe/images"
  ],
  "attributes": {
    "columns": {
      "type": "number",
      "default": 2
    },
    "gap": {
      "type": "boolean",
      "default": true
    },
    "fit": {
      "type": "string",
      "default": "cover"
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "file:./Assets/image-row.js",
  "style": "file:./Assets/image-row.css",
  "render": "file:./render.php"
}
