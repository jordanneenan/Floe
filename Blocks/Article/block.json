{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "floe/article",
  "version": "0.1.0",
  "title": "Article",
  "category": "design",
  "icon": "editor-alignleft",
  "description": "Flexible rich text section with optional button.",
  "textdomain": "floe",
  "attributes": {
    "buttonLabel": {
      "type": "string",
      "default": ""
    },
    "buttonUrl": {
      "type": "string",
      "default": ""
    },
    "surface": {
      "type": "string",
      "default": "base"
    }
  },
  "supports": {
    "anchor": true,
    "className": true,
    "html": false
  },
  "editorScript": "file:./Assets/article.js",
  "style": "file:./Assets/article.css",
  "render": "file:./render.php"
}
