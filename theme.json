{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "860px",
			"wideSize": "1248px",
			"allowEditing": false,
			"allowCustomContentAndWideSize": false
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"link": false,
			"background": false,
			"text": false,
			"palette": [
				{ "name": "Ink", "slug": "ink", "color": "#0B1220" },
				{ "name": "Ink raised", "slug": "ink-raised", "color": "#162033" },
				{ "name": "Muted", "slug": "muted", "color": "#5A6474" },
				{ "name": "Line", "slug": "line", "color": "#E4E7EC" },
				{ "name": "White", "slug": "white", "color": "#FFFFFF" },
				{ "name": "Canvas", "slug": "canvas", "color": "#F4F5F7" },
				{ "name": "Ice", "slug": "ice", "color": "#E8EEF7" },
				{ "name": "Blue", "slug": "blue", "color": "#2B50E8" },
				{ "name": "Blue deep", "slug": "blue-deep", "color": "#2446D8" },
				{ "name": "Blue soft", "slug": "blue-soft", "color": "#DCE4FD" },
				{ "name": "On dark muted", "slug": "on-dark-muted", "color": "#9AA4B5" },
				{ "name": "On dark accent", "slug": "on-dark-accent", "color": "#A9BCFF" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fontStyle": false,
			"fontWeight": false,
			"letterSpacing": false,
			"lineHeight": false,
			"textAlign": false,
			"textColumns": false,
			"textDecoration": false,
			"textTransform": false,
			"writingMode": false,
			"fluid": {
				"minViewportWidth": "375px",
				"maxViewportWidth": "1440px",
				"minFontSize": "14px"
			},
			"fontFamilies": [
				{
					"name": "Geist",
					"slug": "geist",
					"fontFamily": "Geist, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Geist",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/Geist-Variable.woff2" ]
						},
						{
							"fontFamily": "Geist",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/Geist-Italic-Variable.woff2" ]
						}
					]
				},
				{
					"name": "Geist Mono",
					"slug": "geist-mono",
					"fontFamily": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
					"fontFace": [
						{
							"fontFamily": "Geist Mono",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/GeistMono-Variable.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "name": "Display XL", "slug": "display-xl", "size": "84px", "fluid": { "min": "46px", "max": "84px" } },
				{ "name": "Display", "slug": "display", "size": "64px", "fluid": { "min": "40px", "max": "64px" } },
				{ "name": "Heading 1", "slug": "heading-1", "size": "52px", "fluid": { "min": "36px", "max": "52px" } },
				{ "name": "Heading 2", "slug": "heading-2", "size": "40px", "fluid": { "min": "30px", "max": "40px" } },
				{ "name": "Heading 3", "slug": "heading-3", "size": "26px", "fluid": { "min": "22px", "max": "26px" } },
				{ "name": "Heading 4", "slug": "heading-4", "size": "19px", "fluid": false },
				{ "name": "Quote", "slug": "quote", "size": "36px", "fluid": { "min": "26px", "max": "36px" } },
				{ "name": "Body large", "slug": "body-l", "size": "20px", "fluid": { "min": "18px", "max": "20px" } },
				{ "name": "Body", "slug": "body", "size": "17px", "fluid": false },
				{ "name": "Small", "slug": "small", "size": "14px", "fluid": false },
				{ "name": "Label", "slug": "label", "size": "15px", "fluid": false },
				{ "name": "Eyebrow", "slug": "eyebrow", "size": "12px", "fluid": false }
			]
		},
		"spacing": {
			"blockGap": false,
			"margin": false,
			"padding": false,
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [ "px" ],
			"spacingSizes": [
				{ "name": "4", "slug": "10", "size": "4px" },
				{ "name": "8", "slug": "20", "size": "8px" },
				{ "name": "12", "slug": "30", "size": "12px" },
				{ "name": "16", "slug": "40", "size": "16px" },
				{ "name": "24", "slug": "50", "size": "24px" },
				{ "name": "32", "slug": "60", "size": "32px" },
				{ "name": "48", "slug": "70", "size": "48px" },
				{ "name": "64", "slug": "80", "size": "64px" },
				{ "name": "96", "slug": "90", "size": "96px" },
				{ "name": "128", "slug": "100", "size": "128px" }
			]
		},
		"border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"dimensions": {
			"aspectRatio": false,
			"defaultAspectRatios": false,
			"minHeight": false
		},
		"background": {
			"backgroundImage": false,
			"backgroundSize": false
		},
		"position": {
			"sticky": false
		},
		"custom": {
			"radius": {
				"sm": "8px",
				"md": "16px",
				"lg": "24px",
				"xl": "32px",
				"pill": "999px"
			},
			"content": {
				"width": "1248px",
				"gutter": "clamp(20px, 6.667vw, 96px)"
			}
		},
		"blocks": {
			"core/paragraph": {
				"typography": {
					"fontSizes": [
						{ "name": "Body large", "slug": "body-l", "size": "20px", "fluid": { "min": "18px", "max": "20px" } },
						{ "name": "Body", "slug": "body", "size": "17px", "fluid": false },
						{ "name": "Small", "slug": "small", "size": "14px", "fluid": false }
					]
				}
			},
			"core/heading": {
				"typography": {
					"fontSizes": []
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--geist)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"fontWeight": "400",
			"lineHeight": "1.588",
			"letterSpacing": "-0.002em"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--blue)" }
			},
			"heading": {
				"typography": { "fontWeight": "500" }
			},
			"h1": {
				"typography": { "fontSize": "var(--wp--preset--font-size--heading-1)", "lineHeight": "1.077", "letterSpacing": "-0.025em" }
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--heading-2)", "lineHeight": "1.15", "letterSpacing": "-0.02em" }
			},
			"h3": {
				"typography": { "fontSize": "var(--wp--preset--font-size--heading-3)", "lineHeight": "1.231", "letterSpacing": "-0.012em" }
			},
			"h4": {
				"typography": { "fontSize": "var(--wp--preset--font-size--heading-4)", "lineHeight": "1.368", "letterSpacing": "-0.006em", "fontWeight": "600" }
			},
			"h5": {
				"typography": { "fontSize": "var(--wp--preset--font-size--label)", "lineHeight": "1.333", "fontWeight": "600" }
			},
			"h6": {
				"typography": { "fontSize": "var(--wp--preset--font-size--label)", "lineHeight": "1.333", "fontWeight": "600" }
			}
		}
	}
}
